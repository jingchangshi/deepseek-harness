{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepseek-harness.local/agent/review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "taskRevision", "workRevision", "decision", "summary", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string" },
    "taskRevision": { "type": "integer", "minimum": 1 },
    "workRevision": { "type": "integer", "minimum": 1 },
    "decision": { "enum": ["ACCEPT", "FIX_BOUNDED", "REPLAN", "BLOCKED"] },
    "summary": { "type": "string", "minLength": 1 },
    "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocker": { "type": "string", "minLength": 1 }
  }
}
