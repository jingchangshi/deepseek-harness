{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepseek-harness.local/agent/verification-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "taskRevision",
    "workRevision",
    "status",
    "checks",
    "scope",
    "identity"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "taskId": {
      "type": "string"
    },
    "taskRevision": {
      "type": "integer",
      "minimum": 1
    },
    "workRevision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "INCOMPLETE"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "scope",
          "required",
          "status",
          "evidenceIds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "INCOMPLETE"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "scope": {
      "type": "object"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "sourceTreeDigest",
        "verificationPolicyDigest",
        "repositoryProfileDigest",
        "requiredSetDigest"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "sourceTreeDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verificationPolicyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repositoryProfileDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requiredSetDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
