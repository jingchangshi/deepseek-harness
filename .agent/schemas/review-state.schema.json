{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepseek-harness.local/agent/review-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "state", "revision", "workRevision", "fixAttempts", "writer", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "state": { "enum": ["REQUEST", "SNAPSHOT", "SCOPE_CLASSIFIED", "REVIEW_INVESTIGATION", "INDEPENDENT_REVIEW", "EVIDENCE_VALIDATION", "REVIEW_COMPLETE", "PARTIAL", "BLOCKED"] },
    "revision": { "type": "integer", "minimum": 0 },
    "workRevision": { "const": 0 },
    "fixAttempts": { "const": 0 },
    "writer": { "type": "null" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "blocker": { "type": "string", "minLength": 1 },
    "requiresStopConfirmation": { "type": "boolean" }
  }
}
