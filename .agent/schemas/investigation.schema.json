{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepseek-harness.local/agent/investigation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "taskRevision", "findings", "hypotheses", "unresolvedAssumptions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string" },
    "taskRevision": { "type": "integer", "minimum": 1 },
    "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "evidence"],
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "unresolvedAssumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
