{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepseek-harness.local/agent/plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "taskRevision", "workRevision", "problemStatement", "hypotheses", "selectedApproach", "rejectedAlternatives", "invariants", "expectedComponents", "implementationScope", "falsificationTests", "acceptanceGates", "unresolvedAssumptions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string" },
    "taskRevision": { "type": "integer", "minimum": 1 },
    "workRevision": { "type": "integer", "minimum": 1 },
    "problemStatement": { "type": "string", "minLength": 1 },
    "hypotheses": { "$ref": "#/definitions/nonEmptyStrings" },
    "selectedApproach": { "type": "string", "minLength": 1 },
    "rejectedAlternatives": { "$ref": "#/definitions/nonEmptyStrings" },
    "invariants": { "$ref": "#/definitions/nonEmptyStrings" },
    "expectedComponents": { "$ref": "#/definitions/nonEmptyStrings" },
    "implementationScope": { "$ref": "#/definitions/nonEmptyStrings" },
    "falsificationTests": { "$ref": "#/definitions/nonEmptyStrings" },
    "acceptanceGates": { "$ref": "#/definitions/nonEmptyStrings" },
    "unresolvedAssumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "acceptanceBlocking"],
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "acceptanceBlocking": { "type": "boolean" }
        }
      }
    }
  },
  "definitions": {
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
