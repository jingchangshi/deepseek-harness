{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepseek-harness.local/agent/verification-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "taskRevision", "workRevision", "status", "checks", "scope"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "taskId": { "type": "string" },
    "taskRevision": { "type": "integer", "minimum": 1 },
    "workRevision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "INCOMPLETE"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "scope", "required", "status", "evidenceIds"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "scope": { "type": "object" },
          "required": { "type": "boolean" },
          "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "INCOMPLETE"] },
          "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "scope": { "type": "object" }
  }
}
